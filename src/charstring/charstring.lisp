;;; A port of the charstring evaluator in Fontations' read-fonts
;;; (src/ps/charstring.rs and src/ps/cff/stack.rs), which follows FreeType.
;;;
;;; This file is hand-written, not generated by zpb-otf/codegen. It is the
;;; layer above zpb-otf's generated tables and below zpb-ttf's glyph API.
;;;
;;; Numbers are 16.16 fixed point values held as their raw signed 32-bit
;;; bits, as in Fontations: 1.0 is #x10000. Coordinates, widths and hint
;;; edges passed to a sink are in that representation; FIXED->FLOAT
;;; converts one.
;;;
;;; A charstring is an (unsigned-byte 8) vector or a ZPB-OTF:FONT-DATA
;;; window, so charstrings can be evaluated in place in a font's buffer.

(defpackage #:zpb-otf/charstring
  (:use #:cl)
  (:export
   ;; Evaluation
   #:evaluate-charstring #:evaluate-width
   ;; Context
   #:charstring-context #:context-kind #:context-subr #:context-global-subr
   #:context-seac-components #:context-weight-vector #:context-build-char-len
   #:simple-charstring-context #:subr-bias
   ;; Sinks
   #:sink-move-to #:sink-line-to #:sink-curve-to #:sink-close
   #:sink-hstem #:sink-vstem #:sink-hint-mask #:sink-counter-mask
   #:sink-clear-hints #:sink-finish #:null-sink
   ;; CFF2 blending
   #:blend-region-count #:blend-scalars #:blend-set-store-index
   #:constant-blend-state
   #:item-variation-blend-state #:make-blend-state #:blend-coords #:blend-store-index
   ;; Fixed point
   #:fixed-from-int #:fixed->float #:float->fixed
   ;; Conditions
   #:charstring-error #:charstring-limit-exceeded #:charstring-invalid-operation
   #:charstring-malformed #:charstring-missing-resource #:charstring-read-error
   ;; Limits
   #:+nesting-depth-limit+ #:+max-operations+ #:+max-stack+))

(in-package #:zpb-otf/charstring)

;;; Limits

(defconstant +nesting-depth-limit+ 10
  "Maximum nesting depth of subroutine calls (Type 2 spec, appendix B).")
(defconstant +max-operations+ 1000000
  "Maximum number of numbers and operators processed for one glyph.")
(defconstant +max-stack+ 513
  "Maximum number of operands on the stack.")
(defconstant +storage-size+ 32
  "Size of the transient array that `put' and `get' address.")

;;; Conditions, after Fontations' Error variants

(define-condition charstring-error (error)
  ((message :initarg :message :initform nil :reader charstring-error-message))
  (:report (lambda (c s)
             (format s "~A~@[: ~A~]" (type-of c) (charstring-error-message c)))))

(define-condition charstring-limit-exceeded (charstring-error) ())
(define-condition charstring-invalid-operation (charstring-error) ())
(define-condition charstring-malformed (charstring-error) ())
(define-condition charstring-missing-resource (charstring-error) ())
(define-condition charstring-read-error (charstring-error) ())

(defun fail (type &optional message)
  (error type :message message))

;;; 16.16 fixed point arithmetic on raw 32-bit values, matching
;;; font-types' Fixed: addition, subtraction and negation wrap.

(defconstant +fixed-max+ #x7FFFFFFF)

(declaim (inline s32 fixed-from-int fixed+ fixed- fixed-neg))
(defun s32 (x)
  "X reduced to a signed 32-bit integer, wrapping."
  (let ((u (ldb (byte 32 0) x)))
    (if (logbitp 31 u) (- u #x100000000) u)))

(defun fixed-from-int (i)
  "The fixed point value of the integer I (shifted, wrapping like Rust's i << 16)."
  (s32 (ash i 16)))

(defun fixed+ (a b) (s32 (+ a b)))
(defun fixed- (a b) (s32 (- a b)))
(defun fixed-neg (a) (s32 (- a)))

(defun fixed* (a b)
  "Product of two fixed values, rounded like FreeType's FT_MulFix."
  (let ((ab (* a b)))
    (s32 (ash (+ ab #x8000 (if (minusp ab) -1 0)) -16))))

(defun fixed/ (a b)
  "Quotient of two fixed values, rounded like FreeType's FT_DivFix; a zero
divisor gives the largest magnitude."
  (let* ((sign (not (eq (minusp a) (minusp b))))
         (au (abs a))
         (bu (abs b))
         (q (if (zerop bu)
                #x7FFFFFFF
                (ldb (byte 32 0) (floor (+ (ash au 16) (ash bu -1)) bu)))))
    (if sign (s32 (- (s32 q))) (s32 q))))

(defun fixed->float (f)
  (/ f 65536.0d0))

(defun round-half-away (x)
  "X rounded to an integer, halves away from zero, as font-types' from_f64 does."
  (if (minusp x) (- (floor (+ (- x) 1/2))) (floor (+ x 1/2))))

(defun float->fixed (x)
  (s32 (round-half-away (* (rational x) 65536))))

(defun fixed-sqrt (value)
  "Square root by the Babylonian method FreeType uses; zero for anything
not positive."
  (if (<= value 0)
      0
      (let ((root (if (< value 10) value (ash value -1))))
        (loop
          ;; The sum wraps, as Rust's i32 addition does in release builds.
          (let ((next (ash (s32 (+ root (fixed/ value root) 1)) -1)))
            (when (= next root)
              (return next))
            (setf root next))))))

;;; Operand stack (stack.rs). Values are held in parallel arrays of raw
;;; 32-bit values and fixed-point flags. As in Fontations and FreeType,
;;; reads are lossy on purpose: a pop from an empty stack reads slot 0,
;;; and an index past the top reads whatever that slot last held.

(defstruct (stack (:constructor make-stack ()))
  (values (make-array +max-stack+ :element-type '(signed-byte 32) :initial-element 0)
   :type (simple-array (signed-byte 32) (*)))
  (fixedp (make-array +max-stack+ :element-type 'bit :initial-element 0)
   :type simple-bit-vector)
  (top 0 :type fixnum))

(defun stack-len (s) (stack-top s))

(defun stack-clear (s) (setf (stack-top s) 0))

(defun stack-push-raw (s value fixedp)
  (when (= (stack-top s) +max-stack+)
    (fail 'charstring-limit-exceeded "operand stack is full"))
  (setf (aref (stack-values s) (stack-top s)) value
        (aref (stack-fixedp s) (stack-top s)) (if fixedp 1 0))
  (incf (stack-top s)))

(defun stack-push-int (s value) (stack-push-raw s (s32 value) nil))
(defun stack-push-fixed (s value) (stack-push-raw s (s32 value) t))

(defun stack-set-fixed (s index value)
  (when (>= index (stack-top s))
    (fail 'charstring-limit-exceeded "set past the top of the stack"))
  (setf (aref (stack-values s) index) (s32 value)
        (aref (stack-fixedp s) index) 1))

(defun stack-pop-index (s)
  "Index of the popped value; 0 when the stack is already empty."
  (if (plusp (stack-top s))
      (decf (stack-top s))
      0))

(defun stack-get-int (s index)
  "The integer at INDEX; 0 past the array, an error if it holds a fixed value."
  (cond ((>= index +max-stack+) 0)
        ((= 1 (aref (stack-fixedp s) index))
         (fail 'charstring-invalid-operation "expected an integer operand"))
        (t (aref (stack-values s) index))))

(defun stack-get-fixed (s index)
  "The value at INDEX as fixed point, converting an integer; 0 past the array."
  (cond ((>= index +max-stack+) 0)
        ((= 1 (aref (stack-fixedp s) index)) (aref (stack-values s) index))
        (t (fixed-from-int (aref (stack-values s) index)))))

(defun stack-pop-int (s) (stack-get-int s (stack-pop-index s)))
(defun stack-pop-fixed (s) (stack-get-fixed s (stack-pop-index s)))

(defun stack-fixed-array (s first n)
  "List of N fixed values starting at FIRST, padded with zeros past the top."
  (loop for i from first below (+ first n)
        collect (if (< i (stack-top s)) (stack-get-fixed s i) 0)))

(defun stack-drop (s n)
  (setf (stack-top s) (max 0 (- (stack-top s) n))))

(defun stack-exch (s)
  (when (< (stack-top s) 2)
    (fail 'charstring-invalid-operation "exch needs two operands"))
  (let ((a (1- (stack-top s)))
        (b (- (stack-top s) 2)))
    (rotatef (aref (stack-values s) a) (aref (stack-values s) b))
    (rotatef (aref (stack-fixedp s) a) (aref (stack-fixedp s) b))))

(defun stack-roll (s count shift)
  "Rotate the top COUNT values by SHIFT places toward the top."
  (when (< count 2)
    (return-from stack-roll))
  (when (> count (stack-top s))
    (fail 'charstring-invalid-operation "roll count exceeds the stack"))
  (let* ((offset (- (stack-top s) count))
         (n count)
         ;; i32::MIN has no positive counterpart; negate it as Rust's
         ;; wrapping_neg does.
         (shift (if (minusp shift)
                    (- (rem (s32 (- shift)) n))
                    (rem shift n)))
         (values (stack-values s))
         (fixedp (stack-fixedp s)))
    (when (zerop shift)
      (return-from stack-roll))
    ;; Carry one value while its place is filled, walking the cycle.
    (let ((start-idx -1) (idx -1) (last-value 0) (last-fixed 0))
      (dotimes (i count)
        (when (= start-idx idx)
          (incf start-idx)
          (setf idx start-idx)
          (let ((u (+ offset idx)))
            (setf last-value (aref values u) last-fixed (aref fixedp u))))
        (incf idx shift)
        (cond ((>= idx n) (decf idx n))
              ((minusp idx) (incf idx n)))
        (let* ((u (+ offset idx))
               (tmp-value (aref values u))
               (tmp-fixed (aref fixedp u)))
          (setf (aref values u) last-value
                (aref fixedp u) last-fixed
                last-value tmp-value
                last-fixed tmp-fixed))))))

(defun stack-div (s type1-p)
  "Pop B and A and push A / B. A Type 1 integer outside +-32000 is
reinterpreted, with B, as fixed point bits, as FreeType does."
  (let* ((b-idx (stack-pop-index s))
         (a-idx (stack-pop-index s)))
    (multiple-value-bind (a b)
        (if (= 1 (aref (stack-fixedp s) a-idx))
            (values (stack-get-fixed s a-idx) (stack-get-fixed s b-idx))
            (let ((a (stack-get-int s a-idx)))
              (if (and type1-p (not (<= -32000 a 32000)))
                  (values a (stack-get-int s b-idx))
                  (values (stack-get-fixed s a-idx) (stack-get-fixed s b-idx)))))
      (stack-push-fixed s (fixed/ a b)))))

;;; CFF2 blending. A blend state supplies the scalar for each region of
;;; the current ItemVariationData at the instance being drawn.

(defgeneric blend-region-count (blend-state)
  (:documentation "Number of regions of the active ItemVariationData."))
(defgeneric blend-scalars (blend-state)
  (:documentation "Sequence of fixed point scalars, one per region."))
(defgeneric blend-set-store-index (blend-state index)
  (:documentation "Select the ItemVariationData used by later blends (vsindex)."))

(defclass constant-blend-state ()
  ((scalars :initarg :scalars :initform #() :accessor constant-blend-scalars))
  (:documentation "Blend state with fixed scalars, e.g. precomputed by the caller."))

(defmethod blend-region-count ((b constant-blend-state)) (length (constant-blend-scalars b)))
(defmethod blend-scalars ((b constant-blend-state)) (constant-blend-scalars b))
(defmethod blend-set-store-index ((b constant-blend-state) index)
  (declare (ignore index))
  nil)

(defun stack-apply-blend (s blend-state)
  "The `blend' operator: replace target values and their per-region deltas
by the blended target values."
  (let ((target-count (stack-pop-int s)))
    (when (or (minusp target-count) (> target-count (stack-top s)))
      (fail 'charstring-invalid-operation "blend count exceeds the stack"))
    (let* ((region-count (blend-region-count blend-state))
           (operand-count (* target-count (1+ region-count))))
      (when (< (stack-top s) operand-count)
        (fail 'charstring-invalid-operation "too few blend operands"))
      (let* ((start (- (stack-top s) operand-count))
             (end (+ start operand-count))
             (values (stack-values s))
             (fixedp (stack-fixedp s)))
        (loop for i from start below end
              when (zerop (aref fixedp i))
                do (setf (aref values i) (fixed-from-int (aref values i))
                         (aref fixedp i) 1))
        ;; Regions in the outer loop, as Fontations does, so each scalar is
        ;; used once; additions wrap.
        (let ((region-ix 0))
          (map nil
               (lambda (scalar)
                 (unless (zerop scalar)
                   (dotimes (value-ix target-count)
                     (let ((delta (aref values (+ start target-count
                                                  (* region-count value-ix) region-ix)))
                           (v (+ start value-ix)))
                       (setf (aref values v) (fixed+ (aref values v) (fixed* delta scalar))))))
                 (incf region-ix))
               (blend-scalars blend-state)))
        (setf (stack-top s) (+ start target-count))))))

;;; Context

(defclass charstring-context ()
  ()
  (:documentation "Supplies what a charstring refers to: subroutines, seac
components, and multiple master data."))

(defgeneric context-kind (context)
  (:documentation ":TYPE1 or :TYPE2.")
  (:method ((context charstring-context)) :type2))

(defgeneric context-subr (context index)
  (:documentation "The local subroutine for INDEX as encoded in the charstring;
the method applies the subroutine bias.")
  (:method ((context charstring-context) index)
    (declare (ignore index))
    (fail 'charstring-missing-resource "no local subroutines")))

(defgeneric context-global-subr (context index)
  (:documentation "The global subroutine for INDEX as encoded in the charstring;
the method applies the subroutine bias.")
  (:method ((context charstring-context) index)
    (declare (ignore index))
    (fail 'charstring-missing-resource "no global subroutines")))

(defgeneric context-seac-components (context base-code accent-code)
  (:documentation "The base and accent charstrings for a seac, as two values.
BASE-CODE and ACCENT-CODE are Standard Encoding codes.")
  (:method ((context charstring-context) base-code accent-code)
    (declare (ignore base-code accent-code))
    (fail 'charstring-invalid-operation "seac is not supported by this context")))

(defgeneric context-weight-vector (context)
  (:documentation "Weight vector of a multiple master font: a vector of fixed values.")
  (:method ((context charstring-context)) #()))

(defgeneric context-build-char-len (context)
  (:documentation "Length of a multiple master font's BuildCharArray.")
  (:method ((context charstring-context)) 0))

(defun subr-bias (count)
  "Bias added to a subroutine number for an INDEX of COUNT subroutines."
  (cond ((< count 1240) 107)
        ((< count 33900) 1131)
        (t 32768)))

(defclass simple-charstring-context (charstring-context)
  ((kind :initarg :kind :initform :type2 :reader context-kind)
   (global-subrs :initarg :global-subrs :initform nil :reader context-global-subrs)
   (local-subrs :initarg :local-subrs :initform nil :reader context-local-subrs)
   (weight-vector :initarg :weight-vector :initform #() :reader context-weight-vector)
   (build-char-len :initarg :build-char-len :initform 0 :reader context-build-char-len))
  (:documentation "Context over sequences of subroutine charstrings, applying
the CFF subroutine bias. A NIL sequence means the font has none."))

(defun biased-subr (subrs index what)
  (unless subrs
    (fail 'charstring-missing-resource what))
  (let ((i (+ index (subr-bias (length subrs)))))
    (if (< -1 i (length subrs))
        (elt subrs i)
        (fail 'charstring-malformed (format nil "~A ~D out of range" what index)))))

(defmethod context-subr ((context simple-charstring-context) index)
  (biased-subr (context-local-subrs context) index "local subroutine"))

(defmethod context-global-subr ((context simple-charstring-context) index)
  (biased-subr (context-global-subrs context) index "global subroutine"))

;;; Sinks. Only the path operations must be implemented; the hint
;;; operations default to doing nothing.

(defgeneric sink-move-to (sink x y))
(defgeneric sink-line-to (sink x y))
(defgeneric sink-curve-to (sink cx0 cy0 cx1 cy1 x y))
(defgeneric sink-close (sink))
(defgeneric sink-hstem (sink y dy) (:method (sink y dy) (declare (ignore sink y dy))))
(defgeneric sink-vstem (sink x dx) (:method (sink x dx) (declare (ignore sink x dx))))
(defgeneric sink-hint-mask (sink mask) (:method (sink mask) (declare (ignore sink mask))))
(defgeneric sink-counter-mask (sink mask) (:method (sink mask) (declare (ignore sink mask))))
(defgeneric sink-clear-hints (sink) (:method (sink) (declare (ignore sink))))
(defgeneric sink-finish (sink) (:method (sink) (declare (ignore sink))))

(defclass null-sink () () (:documentation "Sink that discards everything."))
(defmethod sink-move-to ((s null-sink) x y) (declare (ignore x y)))
(defmethod sink-line-to ((s null-sink) x y) (declare (ignore x y)))
(defmethod sink-curve-to ((s null-sink) cx0 cy0 cx1 cy1 x y)
  (declare (ignore cx0 cy0 cx1 cy1 x y)))
(defmethod sink-close ((s null-sink)))

(defvar *null-sink* (make-instance 'null-sink))

;;; Reading charstring bytes

(defstruct (cursor (:constructor make-cursor (bytes pos end)))
  (bytes nil :type (simple-array (unsigned-byte 8) (*)))
  (pos 0 :type fixnum)
  (end 0 :type fixnum))

(defun charstring-cursor (charstring)
  "Cursor over CHARSTRING, an octet vector or a ZPB-OTF:FONT-DATA window.
Simple vectors and FONT-DATA are read in place; any other octet vector,
such as an adjustable one, is copied first."
  (etypecase charstring
    ((simple-array (unsigned-byte 8) (*))
     (make-cursor charstring 0 (length charstring)))
    (zpb-otf:font-data
     (let ((start (zpb-otf:font-data-offset charstring)))
       (make-cursor (zpb-otf:font-data-bytes charstring)
                    start (+ start (zpb-otf:font-data-length charstring)))))
    ((vector (unsigned-byte 8))
     (charstring-cursor (coerce charstring '(simple-array (unsigned-byte 8) (*)))))))

(defun empty-cursor ()
  (make-cursor (make-array 0 :element-type '(unsigned-byte 8)) 0 0))

(defun cursor-remaining (c) (- (cursor-end c) (cursor-pos c)))

(defun cursor-u8 (c)
  (when (>= (cursor-pos c) (cursor-end c))
    (fail 'charstring-read-error "charstring ends early"))
  (prog1 (aref (cursor-bytes c) (cursor-pos c))
    (incf (cursor-pos c))))

(defun cursor-int (c bytes)
  "Signed big-endian integer of BYTES bytes."
  (let ((u 0))
    (dotimes (i bytes)
      (setf u (logior (ash u 8) (cursor-u8 c))))
    (if (logbitp (1- (* 8 bytes)) u) (- u (ash 1 (* 8 bytes))) u)))

(defun cursor-octets (c count)
  (when (> count (cursor-remaining c))
    (fail 'charstring-read-error "hint mask runs past the charstring"))
  (prog1 (subseq (cursor-bytes c) (cursor-pos c) (+ (cursor-pos c) count))
    (incf (cursor-pos c) count)))

(defun parse-int (c b0)
  "The integer encoded by B0 and the bytes after it (num.rs parse_int)."
  (cond
    ((<= 32 b0 246) (- b0 139))
    ((<= 247 b0 250) (+ (* (- b0 247) 256) (cursor-u8 c) 108))
    ((<= 251 b0 254) (- (- (* (- b0 251) 256)) (cursor-u8 c) 108))
    ((= b0 28) (cursor-int c 2))
    ((= b0 29) (cursor-int c 4))
    (t (fail 'charstring-malformed (format nil "byte ~D is not a number" b0)))))

;;; Operators

(defparameter *one-byte-operators*
  (let ((table (make-array 32 :initial-element nil)))
    (loop for (code name) on '(1 :hstem 3 :vstem 4 :vmoveto 5 :rlineto 6 :hlineto
                               7 :vlineto 8 :rrcurveto 10 :callsubr 11 :return
                               13 :hsbw 14 :endchar 15 :vsindex 16 :blend
                               18 :hstemhm 19 :hintmask 20 :cntrmask 21 :rmoveto
                               22 :hmoveto 23 :vstemhm 24 :rcurveline 25 :rlinecurve
                               26 :vvcurveto 27 :hhcurveto 29 :callgsubr
                               30 :vhcurveto 31 :hvcurveto)
          by #'cddr
          do (setf (aref table code) name))
    table))

(defparameter *two-byte-operators*
  ;; `random' (12 23) is deliberately absent, as in Fontations.
  (let ((table (make-array 38 :initial-element nil)))
    (loop for (code name) on '(0 :dotsection 1 :vstem3 2 :hstem3 3 :and 4 :or 5 :not
                               6 :seac 7 :sbw 9 :abs 10 :add 11 :sub 12 :div
                               14 :neg 15 :eq 16 :callothersubr 17 :pop 18 :drop
                               20 :put 21 :get 22 :ifelse 24 :mul 26 :sqrt
                               27 :dup 28 :exch 29 :index 30 :roll
                               33 :setcurrentpoint 34 :hflex 35 :flex
                               36 :hflex1 37 :flex1)
          by #'cddr
          do (setf (aref table code) name))
    table))

(defun read-operator (c b0)
  "The operator starting with B0, or NIL for a reserved one."
  (if (= b0 12)
      (if (plusp (cursor-remaining c))
          (let ((b1 (cursor-u8 c)))
            (when (< b1 (length *two-byte-operators*))
              (aref *two-byte-operators* b1)))
          nil)
      (when (< b0 (length *one-byte-operators*))
        (aref *one-byte-operators* b0))))

;;; Evaluator

(defstruct (evaluator (:conc-name ev-))
  (context nil)
  (type1-p nil)
  (blend-state nil)
  (sink nil)
  (open-p nil)
  ;; While flexing, moveto operators accumulate flex vectors on the stack.
  (flexing-p nil)
  ;; A command that may carry the width has been seen.
  (seen-width-command nil)
  (width-only nil)
  (have-read-width nil)
  (stem-count 0 :type fixnum)
  (x 0) (y 0)
  (sbx 0)
  (wx 0)
  (stack (make-stack))
  (stack-ix 0 :type fixnum)
  (in-seac nil)
  (ops-done 0 :type fixnum)
  (storage (make-array +storage-size+ :initial-element 0))
  ;; A multiple master font's BuildCharArray, sized on first use.
  (build-char (make-array 0 :adjustable t :initial-element 0)))

(defun make-evaluator-for (context blend-state sink)
  (make-evaluator :context context
                  :type1-p (eq (context-kind context) :type1)
                  :blend-state blend-state
                  :sink sink))

(defun evaluate-charstring (context charstring sink &key blend-state)
  "Evaluate CHARSTRING, sending its outline to SINK. Return the width the
charstring states (fixed point), or NIL when it states none and the
font's default width applies.

BLEND-STATE is required for a CFF2 charstring that uses `blend' or
`vsindex'."
  (let ((ev (make-evaluator-for context blend-state sink)))
    (evaluator-run ev charstring)
    (sink-finish sink)
    (when (ev-have-read-width ev)
      (ev-wx ev))))

(defun evaluate-width (context charstring &key blend-state)
  "The width CHARSTRING states, without drawing it; NIL if it states none.
Evaluation stops at the first stack-clearing operator."
  (let ((ev (make-evaluator-for context blend-state *null-sink*)))
    (setf (ev-width-only ev) t)
    (evaluator-run ev charstring)
    (when (ev-have-read-width ev)
      (ev-wx ev))))

(defun evaluator-run (ev charstring)
  (let ((seen-endchar (evaluate-impl ev (charstring-cursor charstring) 0)))
    ;; FreeType simulates an endchar for CFF and CFF2.
    (when (and (not (ev-type1-p ev)) (not seen-endchar))
      (evaluate-operator ev :endchar (empty-cursor) 0))
    (when (ev-open-p ev)
      (sink-close (ev-sink ev)))))

(defun evaluate-impl (ev c depth)
  "Evaluate from cursor C. Return true if an endchar was seen."
  (when (> depth +nesting-depth-limit+)
    (fail 'charstring-limit-exceeded "subroutines nested too deeply"))
  (let ((stack (ev-stack ev))
        (seen-endchar nil))
    (loop while (plusp (cursor-remaining c))
          do (when (> (incf (ev-ops-done ev)) +max-operations+)
               (fail 'charstring-limit-exceeded "too many operations"))
             (let ((b0 (cursor-u8 c)))
               (cond
                 ;; Byte 29 is not a number here: it is callgsubr in a
                 ;; charstring (it encodes a 32-bit integer only in DICTs).
                 ((or (= b0 28) (<= 32 b0 254))
                  (stack-push-int stack (parse-int c b0)))
                 ((= b0 255)
                  ;; Type 1 reads an integer, Type 2 a raw 16.16 value.
                  (let ((v (cursor-int c 4)))
                    (if (ev-type1-p ev)
                        (stack-push-int stack v)
                        (stack-push-fixed stack v))))
                 (t
                  ;; FreeType ignores reserved operators, clearing the stack.
                  (let ((op (read-operator c b0)))
                    (cond
                      ((null op) (reset-stack ev))
                      (t
                       (when (eq op :endchar) (setf seen-endchar t))
                       (unless (evaluate-operator ev op c depth)
                         (return))
                       ;; The first stack-clearing operator settles the width.
                       (when (and (ev-width-only ev) (ev-seen-width-command ev))
                         (return)))))))))
    seen-endchar))

(defun reset-stack (ev)
  (stack-clear (ev-stack ev))
  (setf (ev-stack-ix ev) 0))

(defun read-width (ev)
  (setf (ev-wx ev) (stack-get-fixed (ev-stack ev) 0)
        (ev-seen-width-command ev) t
        (ev-have-read-width ev) t))

(defun ensure-open (ev)
  (unless (ev-open-p ev)
    (sink-move-to (ev-sink ev) 0 0)
    (setf (ev-open-p ev) t)))

(defun emit-line (ev)
  (ensure-open ev)
  (sink-line-to (ev-sink ev) (ev-x ev) (ev-y ev)))

(defun move-to (ev)
  "Start a subpath at the current point, closing the previous one."
  (if (ev-open-p ev)
      (sink-close (ev-sink ev))
      (setf (ev-open-p ev) t))
  (sink-move-to (ev-sink ev) (ev-x ev) (ev-y ev)))

(defun coords-remaining (ev)
  (max 0 (- (stack-len (ev-stack ev)) (ev-stack-ix ev))))

(defun stack-arg (ev offset)
  (stack-get-fixed (ev-stack ev) (+ (ev-stack-ix ev) offset)))

(defun emit-curves (ev &rest modes)
  "Emit curves whose points are computed from the stack by MODES, a list of
:DX-DY, :X-DY, :DX-Y, :DX-INITIAL-Y, :D-LARGER-COORD-DIST, or
(:DX-MAYBE-DY flag) / (:MAYBE-DX-DY flag); every three points make a curve."
  (let ((initial-x (ev-x ev))
        (initial-y (ev-y ev))
        (count 0)
        (cx0 0) (cy0 0) (cx1 0) (cy1 0))
    (ensure-open ev)
    (dolist (mode modes)
      (let ((used
              (destructuring-bind (kind &optional flag) (if (consp mode) mode (list mode))
                (ecase kind
                  (:dx-dy
                   (setf (ev-x ev) (fixed+ (ev-x ev) (stack-arg ev 0))
                         (ev-y ev) (fixed+ (ev-y ev) (stack-arg ev 1)))
                   2)
                  (:x-dy
                   (setf (ev-y ev) (fixed+ (ev-y ev) (stack-arg ev 0)))
                   1)
                  (:dx-y
                   (setf (ev-x ev) (fixed+ (ev-x ev) (stack-arg ev 0)))
                   1)
                  (:dx-initial-y
                   (setf (ev-x ev) (fixed+ (ev-x ev) (stack-arg ev 0))
                         (ev-y ev) initial-y)
                   1)
                  ;; Delta for the coordinate further from where we started;
                  ;; the other returns to its starting value.
                  (:d-larger-coord-dist
                   (let ((delta (stack-arg ev 0)))
                     (if (> (abs (fixed- (ev-x ev) initial-x))
                            (abs (fixed- (ev-y ev) initial-y)))
                         (setf (ev-x ev) (fixed+ (ev-x ev) delta)
                               (ev-y ev) initial-y)
                         (setf (ev-y ev) (fixed+ (ev-y ev) delta)
                               (ev-x ev) initial-x)))
                   1)
                  (:dx-maybe-dy
                   (setf (ev-x ev) (fixed+ (ev-x ev) (stack-arg ev 0)))
                   (cond (flag (setf (ev-y ev) (fixed+ (ev-y ev) (stack-arg ev 1))) 2)
                         (t 1)))
                  (:maybe-dx-dy
                   (setf (ev-y ev) (fixed+ (ev-y ev) (stack-arg ev 0)))
                   (cond (flag (setf (ev-x ev) (fixed+ (ev-x ev) (stack-arg ev 1))) 2)
                         (t 1)))))))
        (incf (ev-stack-ix ev) used)
        (case count
          (0 (setf cx0 (ev-x ev) cy0 (ev-y ev) count 1))
          (1 (setf cx1 (ev-x ev) cy1 (ev-y ev) count 2))
          (t (sink-curve-to (ev-sink ev) cx0 cy0 cx1 cy1 (ev-x ev) (ev-y ev))
             (setf count 0)))))))

(defun stem-operands (ev sink-fn)
  "Read the stem hints on the stack, after an odd leading width; call
SINK-FN with each hint's two edges and return the number of operands used."
  (let* ((stack (ev-stack ev))
         (i 0)
         (len (if (and (oddp (stack-len stack)) (not (ev-seen-width-command ev)))
                  (progn (read-width ev) (setf i 1) (1- (stack-len stack)))
                  (stack-len stack)))
         (u 0))
    (setf (ev-seen-width-command ev) t)
    (loop while (< i (stack-len stack))
          do (destructuring-bind (du w) (stack-fixed-array stack i 2)
               (setf u (fixed+ u du))
               (let ((v (fixed+ u w)))
                 (funcall sink-fn u v)
                 (setf u v)))
             (incf i 2))
    len))

(defun evaluate-operator (ev op c depth)
  "Evaluate operator OP. Return true if evaluation should continue."
  (let ((stack (ev-stack ev))
        (sink (ev-sink ev)))
    (case op
      ;; The flex operators emit two curves, as FreeType does, whatever
      ;; the flex depth.
      (:flex
       (emit-curves ev :dx-dy :dx-dy :dx-dy :dx-dy :dx-dy :dx-dy)
       (reset-stack ev))
      (:hflex
       (emit-curves ev :dx-y :dx-dy :dx-y :dx-y :dx-initial-y :dx-y)
       (reset-stack ev))
      (:hflex1
       (emit-curves ev :dx-dy :dx-dy :dx-y :dx-y :dx-dy :dx-initial-y)
       (reset-stack ev))
      (:flex1
       (emit-curves ev :dx-dy :dx-dy :dx-dy :dx-dy :dx-dy :d-larger-coord-dist)
       (reset-stack ev))

      ;; CFF2 variations
      (:vsindex
       (unless (ev-type1-p ev)
         (let ((blend-state (or (ev-blend-state ev)
                                (fail 'charstring-missing-resource "vsindex without a blend state"))))
           (blend-set-store-index blend-state (ldb (byte 16 0) (stack-pop-int stack))))))
      (:blend
       (unless (ev-type1-p ev)
         (stack-apply-blend stack (or (ev-blend-state ev)
                                      (fail 'charstring-missing-resource "blend without a blend state")))))

      (:return
       (return-from evaluate-operator nil))

      (:endchar
       (let ((len (stack-len stack)))
         (when (and (or (= len 1) (= len 5)) (not (ev-seen-width-command ev)))
           (read-width ev))
         (setf (ev-seen-width-command ev) t)
         (when (and (> len 1) (not (ev-width-only ev)))
           (handle-seac ev :implicit depth)))
       (return-from evaluate-operator nil))

      ((:hstem :vstem :hstemhm :vstemhm)
       (let ((len (stem-operands ev (if (member op '(:hstem :hstemhm))
                                        (lambda (u v) (sink-hstem sink u v))
                                        (lambda (u v) (sink-vstem sink u v))))))
         (incf (ev-stem-count ev) (floor len 2))
         (reset-stack ev)))

      ;; Operands before a mask are an implied vstemhm.
      ((:hintmask :cntrmask)
       (let ((len (stem-operands ev (lambda (u v) (sink-vstem sink u v)))))
         (incf (ev-stem-count ev) (floor len 2))
         (let ((mask (cursor-octets c (ceiling (ev-stem-count ev) 8))))
           (if (eq op :hintmask)
               (sink-hint-mask sink mask)
               (sink-counter-mask sink mask))))
       (reset-stack ev))

      (:rmoveto
       (when (and (> (stack-len stack) 2) (not (ev-seen-width-command ev)))
         (read-width ev))
       (setf (ev-seen-width-command ev) t)
       (unless (ev-flexing-p ev)
         (let* ((dy (stack-pop-fixed stack))
                (dx (stack-pop-fixed stack)))
           (setf (ev-x ev) (fixed+ (ev-x ev) dx)
                 (ev-y ev) (fixed+ (ev-y ev) dy))
           (move-to ev)
           (reset-stack ev))))

      ((:hmoveto :vmoveto)
       (when (and (> (stack-len stack) 1) (not (ev-seen-width-command ev)))
         (read-width ev))
       (setf (ev-seen-width-command ev) t)
       (if (ev-flexing-p ev)
           ;; Complete the flex vector with the other coordinate.
           (progn
             (stack-push-int stack 0)
             (when (eq op :vmoveto)
               (stack-exch stack)))
           (let ((delta (stack-pop-fixed stack)))
             (if (eq op :hmoveto)
                 (setf (ev-x ev) (fixed+ (ev-x ev) delta))
                 (setf (ev-y ev) (fixed+ (ev-y ev) delta)))
             (move-to ev)
             (reset-stack ev))))

      (:rlineto
       (loop for i from 0 below (stack-len stack) by 2
             do (destructuring-bind (dx dy) (stack-fixed-array stack i 2)
                  (setf (ev-x ev) (fixed+ (ev-x ev) dx)
                        (ev-y ev) (fixed+ (ev-y ev) dy))
                  (emit-line ev)))
       (reset-stack ev))

      ((:hlineto :vlineto)
       (let ((x-p (eq op :hlineto)))
         (dotimes (i (stack-len stack))
           (let ((delta (stack-get-fixed stack i)))
             (if x-p
                 (setf (ev-x ev) (fixed+ (ev-x ev) delta))
                 (setf (ev-y ev) (fixed+ (ev-y ev) delta)))
             (setf x-p (not x-p))
             (emit-line ev))))
       (reset-stack ev))

      (:hhcurveto
       ;; FreeType's count1 & ~2.
       (let* ((count1 (stack-len stack))
              (count (logandc2 count1 2)))
         (setf (ev-stack-ix ev) (- count1 count))
         (loop while (< (ev-stack-ix ev) count)
               do (when (oddp (- count (ev-stack-ix ev)))
                    (setf (ev-y ev) (fixed+ (ev-y ev) (stack-arg ev 0)))
                    (incf (ev-stack-ix ev)))
                  (emit-curves ev :dx-y :dx-dy :dx-y)))
       (reset-stack ev))

      (:vvcurveto
       (let* ((count1 (stack-len stack))
              (count (logandc2 count1 2)))
         (setf (ev-stack-ix ev) (- count1 count))
         (loop while (< (ev-stack-ix ev) count)
               do (when (oddp (- count (ev-stack-ix ev)))
                    (setf (ev-x ev) (fixed+ (ev-x ev) (stack-arg ev 0)))
                    (incf (ev-stack-ix ev)))
                  (emit-curves ev :x-dy :dx-dy :x-dy)))
       (reset-stack ev))

      ((:hvcurveto :vhcurveto)
       (let* ((count1 (stack-len stack))
              (count (logandc2 count1 2))
              (horizontal-p (eq op :hvcurveto)))
         (setf (ev-stack-ix ev) (- count1 count))
         (loop while (< (ev-stack-ix ev) count)
               do (let ((last-delta-p (= (- count (ev-stack-ix ev)) 5)))
                    (if horizontal-p
                        (emit-curves ev :dx-y :dx-dy (list :maybe-dx-dy last-delta-p))
                        (emit-curves ev :x-dy :dx-dy (list :dx-maybe-dy last-delta-p))))
                  (setf horizontal-p (not horizontal-p))))
       (reset-stack ev))

      ((:rrcurveto :rcurveline)
       (loop while (>= (coords-remaining ev) 6)
             do (emit-curves ev :dx-dy :dx-dy :dx-dy))
       (when (eq op :rcurveline)
         (destructuring-bind (dx dy) (stack-fixed-array stack (ev-stack-ix ev) 2)
           (setf (ev-x ev) (fixed+ (ev-x ev) dx)
                 (ev-y ev) (fixed+ (ev-y ev) dy))
           (emit-line ev)))
       (reset-stack ev))

      (:rlinecurve
       (loop while (> (coords-remaining ev) 6)
             do (destructuring-bind (dx dy) (stack-fixed-array stack (ev-stack-ix ev) 2)
                  (setf (ev-x ev) (fixed+ (ev-x ev) dx)
                        (ev-y ev) (fixed+ (ev-y ev) dy))
                  (emit-line ev)
                  (incf (ev-stack-ix ev) 2)))
       (loop while (>= (coords-remaining ev) 6)
             do (emit-curves ev :dx-dy :dx-dy :dx-dy))
       (reset-stack ev))

      ((:callsubr :callgsubr)
       (let* ((index (stack-pop-int stack))
              (subr (if (eq op :callsubr)
                        (context-subr (ev-context ev) index)
                        (context-global-subr (ev-context ev) index))))
         (evaluate-impl ev (charstring-cursor subr) (1+ depth))))

      ;; Type 1 metrics: side bearing and width, and the current point.
      (:hsbw
       (when (ev-type1-p ev)
         (destructuring-bind (sbx wx) (stack-fixed-array stack 0 2)
           (setf (ev-sbx ev) (fixed+ (ev-sbx ev) sbx)
                 (ev-x ev) (fixed+ (ev-x ev) sbx)
                 (ev-wx ev) wx
                 (ev-seen-width-command ev) t
                 (ev-have-read-width ev) t)
           (reset-stack ev))))
      (:sbw
       (when (ev-type1-p ev)
         (destructuring-bind (x y wx wy) (stack-fixed-array stack 0 4)
           (declare (ignore wy))
           (setf (ev-x ev) (fixed+ (ev-x ev) x)
                 (ev-y ev) (fixed+ (ev-y ev) y)
                 (ev-sbx ev) (fixed+ (ev-sbx ev) x)
                 (ev-wx ev) wx
                 (ev-seen-width-command ev) t
                 (ev-have-read-width ev) t)
           (reset-stack ev))))
      (:seac
       (unless (ev-width-only ev)
         (handle-seac ev :explicit depth)))
      (:dotsection)
      ((:hstem3 :vstem3)
       ;; Unimplemented, as in Fontations.
       (reset-stack ev))
      (:setcurrentpoint
       (when (ev-type1-p ev)
         (destructuring-bind (x y) (stack-fixed-array stack 0 2)
           (setf (ev-x ev) x (ev-y ev) y)
           (reset-stack ev))))
      (:callothersubr
       (handle-othersubr ev))
      ;; Results of othersubrs are left on the stack, so pop does nothing.
      (:pop)

      ;; Arithmetic, logic, storage and stack operators. Deprecated in Type 2
      ;; and forbidden in CFF2, but FreeType evaluates them. None clears the
      ;; stack.
      (:div
       (stack-div stack (ev-type1-p ev)))
      ((:and :or :eq)
       (let* ((b (stack-pop-fixed stack))
              (a (stack-pop-fixed stack)))
         ;; These answer with an integer.
         (stack-push-int stack (if (ecase op
                                     (:and (and (/= a 0) (/= b 0)))
                                     (:or (or (/= a 0) (/= b 0)))
                                     (:eq (= a b)))
                                   1 0))))
      (:not
       (stack-push-int stack (if (zerop (stack-pop-fixed stack)) 1 0)))
      ((:abs :neg)
       (let ((a (stack-pop-fixed stack)))
         ;; The most negative value saturates rather than wrapping.
         (stack-push-fixed stack (cond ((< a (- +fixed-max+)) +fixed-max+)
                                       ((eq op :abs) (abs a))
                                       (t (- a))))))
      ((:add :sub)
       (let* ((b (stack-pop-fixed stack))
              (a (stack-pop-fixed stack)))
         ;; Wrapping, as FreeType's ADD_INT32 and SUB_INT32 are.
         (stack-push-fixed stack (if (eq op :add) (fixed+ a b) (fixed- a b)))))
      (:mul
       (let* ((b (stack-pop-fixed stack))
              (a (stack-pop-fixed stack)))
         (stack-push-fixed stack (fixed* a b))))
      (:sqrt
       (stack-push-fixed stack (fixed-sqrt (stack-pop-fixed stack))))
      (:drop
       (stack-pop-fixed stack))
      (:dup
       (let ((a (stack-pop-fixed stack)))
         (stack-push-fixed stack a)
         (stack-push-fixed stack a)))
      (:exch
       (stack-exch stack))
      (:index
       (let ((index (stack-pop-int stack))
             (len (stack-len stack)))
         (when (plusp len)
           ;; A negative index names the top and one past the end the bottom.
           (let ((from-bottom (cond ((minusp index) (1- len))
                                    ((>= index len) 0)
                                    (t (- len 1 index)))))
             (stack-push-fixed stack (stack-get-fixed stack from-bottom))))))
      (:roll
       (let* ((shift (stack-pop-int stack))
              (count (stack-pop-int stack)))
         (stack-roll stack count shift)))
      (:put
       (let* ((index (stack-pop-int stack))
              (value (stack-pop-fixed stack)))
         ;; An index the array cannot hold is dropped.
         (when (< -1 index +storage-size+)
           (setf (aref (ev-storage ev) index) value))))
      (:get
       (let ((index (stack-pop-int stack)))
         ;; An index the array cannot hold pushes nothing.
         (when (< -1 index +storage-size+)
           (stack-push-fixed stack (aref (ev-storage ev) index)))))
      (:ifelse
       (let* ((cond2 (stack-pop-fixed stack))
              (cond1 (stack-pop-fixed stack))
              (arg2 (stack-pop-fixed stack))
              (arg1 (stack-pop-fixed stack)))
         (stack-push-fixed stack (if (<= cond1 cond2) arg1 arg2))))))
  t)

;;; seac

(defun handle-seac (ev mode depth)
  "Draw an accented character from a base and an accent glyph. MODE is
:EXPLICIT for the Type 1 `seac' operator, :IMPLICIT for `endchar' with
extra operands."
  (when (ev-in-seac ev)
    (fail 'charstring-limit-exceeded "nested seac"))
  (setf (ev-in-seac ev) t)
  (let* ((stack (ev-stack ev))
         (accent-code (stack-pop-int stack))
         (base-code (stack-pop-int stack)))
    (multiple-value-bind (base-charstring accent-charstring)
        (context-seac-components (ev-context ev) base-code accent-code)
      (let* ((dy (stack-pop-fixed stack))
             (dx (stack-pop-fixed stack))
             (sb (cond ((ev-type1-p ev)
                        ;; Type 1 has an extra side bearing operand.
                        (stack-pop-fixed stack))
                       ((and (plusp (stack-len stack)) (not (ev-seen-width-command ev)))
                        (setf (ev-wx ev) (stack-pop-fixed stack)
                              (ev-seen-width-command ev) t)
                        0)
                       (t 0)))
             ;; Metrics to restore afterwards.
             (sbx (ev-sbx ev))
             (wx (ev-wx ev))
             (seen-width (ev-seen-width-command ev))
             (read-width (ev-have-read-width ev))
             (explicit-p (eq mode :explicit))
             ;; The base of an explicit seac is always at the origin in FreeType.
             (base (list base-charstring
                         (if explicit-p 0 (ev-x ev))
                         (if explicit-p 0 (ev-y ev))
                         ;; Use the base's metrics if the charstring stated none.
                         explicit-p))
             (accent (list accent-charstring
                           (fixed- (fixed+ dx (ev-sbx ev)) sb)
                           dy
                           nil)))
        ;; FreeType draws the accent first for an implicit seac.
        (dolist (component (if explicit-p (list base accent) (list accent base)))
          (destructuring-bind (charstring x y use-metrics-p) component
            (reset-stack ev)
            ;; Each component gets fresh stem hints.
            (setf (ev-seen-width-command ev) nil
                  (ev-stem-count ev) 0
                  (ev-x ev) x
                  (ev-y ev) y)
            (sink-clear-hints (ev-sink ev))
            (evaluate-impl ev (charstring-cursor charstring) (1+ depth))
            (when (and use-metrics-p (not seen-width))
              (setf sbx (ev-sbx ev)
                    wx (ev-wx ev)))))
        (setf (ev-seen-width-command ev) seen-width
              (ev-have-read-width ev) read-width
              (ev-sbx ev) sbx
              (ev-wx ev) wx
              (ev-in-seac ev) nil)))))

;;; Type 1 othersubrs

(defun handle-othersubr (ev)
  (let* ((stack (ev-stack ev))
         (subr-idx (stack-pop-int stack))
         ;; A negative count is huge, as Rust's cast to usize makes it.
         (num-args (let ((n (stack-pop-int stack)))
                     (if (minusp n) most-positive-fixnum n)))
         (weights (context-weight-vector (ev-context ev))))
    (cond
      ;; End flex: emit curves from the accumulated vectors.
      ((and (= subr-idx 0) (= num-args 3))
       (setf (ev-flexing-p ev) nil)
       (ensure-open ev)
       (handle-flex ev))
      ;; Begin flex: accumulate vectors from moveto operators.
      ((and (= subr-idx 1) (= num-args 0))
       (setf (ev-flexing-p ev) t))
      ;; Counter control hints.
      ((member subr-idx '(12 13))
       (reset-stack ev))
      ;; Multiple master blends; a font with no masters fails the glyph.
      ((<= 14 subr-idx 18)
       (when (zerop (length weights))
         (fail 'charstring-invalid-operation "blend othersubr without masters"))
       (handle-mm-blend ev subr-idx num-args))
      ((or (<= 19 subr-idx 25) (= subr-idx 27))
       (handle-build-char ev subr-idx num-args))
      ;; Unknown: drop its arguments and keep going.
      (t (stack-drop stack num-args)))))

(defun handle-flex (ev)
  "Emit the two curves of a Type 1 flex from the accumulated vectors."
  (let* ((stack (ev-stack ev))
         (popped (loop repeat 17 collect (stack-pop-fixed stack))))
    ;; Popped top first: final-y final-x height p3y p3x bcp4y bcp4x bcp3y
    ;; bcp3x p2y p2x bcp2y bcp2x bcp1y bcp1x rpy rpx.
    (destructuring-bind (final-y final-x height p3y p3x bcp4y bcp4x bcp3y bcp3x
                         p2y p2x bcp2y bcp2x bcp1y bcp1x rpy rpx)
        popped
      (declare (ignore height))
      (reset-stack ev)
      (dolist (v (list (fixed+ bcp1x rpx) (fixed+ bcp1y rpy) bcp2x bcp2y p2x p2y))
        (stack-push-fixed stack v))
      (emit-curves ev :dx-dy :dx-dy :dx-dy)
      (reset-stack ev)
      (dolist (v (list bcp3x bcp3y bcp4x bcp4y p3x p3y))
        (stack-push-fixed stack v))
      (emit-curves ev :dx-dy :dx-dy :dx-dy)
      (reset-stack ev)
      ;; Leave the final position for the setcurrentpoint that follows.
      (stack-push-fixed stack final-x)
      (stack-push-fixed stack final-y))))

(defun handle-mm-blend (ev subr-idx num-args)
  "Blend point values of a multiple master font (othersubrs 14 to 18)."
  (let* ((weights (context-weight-vector (ev-context ev)))
         (stack (ev-stack ev))
         (num-points (+ (- subr-idx 13) (if (= subr-idx 18) 1 0))))
    (unless (= num-args (* num-points (length weights)))
      (fail 'charstring-malformed "wrong blend argument count"))
    ;; NUM-POINTS values, then NUM-POINTS * (weights - 1) deltas; the first
    ;; weight is ignored, as in FreeType.
    (let ((stack-base (- (stack-len stack) num-args)))
      (when (minusp stack-base)
        (fail 'charstring-invalid-operation "too few blend operands"))
      (let ((delta-idx (+ stack-base num-points)))
        (dotimes (i num-points)
          (let ((val (stack-get-fixed stack (+ stack-base i))))
            (loop for w from 1 below (length weights)
                  do (setf val (fixed+ val (fixed* (stack-get-fixed stack delta-idx)
                                                   (elt weights w))))
                     (incf delta-idx))
            (stack-set-fixed stack (+ stack-base i) val))))
      (stack-drop stack (max 0 (- num-args num-points))))))

(defun build-char-array (ev len)
  "The BuildCharArray, sized to LEN zeroed elements on first use."
  (let ((array (ev-build-char ev)))
    (unless (= (length array) len)
      (setf array (adjust-array array len :initial-element 0)
            (ev-build-char ev) array))
    array))

(defun handle-build-char (ev subr-idx num-args)
  "Othersubrs 19 to 25 and 27, which compute with the BuildCharArray and
the blend. Results are left on the stack for the `pop' that follows."
  (let* ((stack (ev-stack ev))
         (weights (context-weight-vector (ev-context ev)))
         (has-blend (plusp (length weights)))
         (len (context-build-char-len (ev-context ev))))
    (flet ((bad () (fail 'charstring-invalid-operation "invalid othersubr call"))
           (u32-index () (ldb (byte 32 0) (stack-pop-int stack))))
      (cond
        ;; <idx> 1 19 callothersubr copies the weights into the array at idx.
        ((and (= subr-idx 19) (= num-args 1) has-blend)
         (let ((idx (u32-index)))
           (when (or (< len (length weights)) (< (- len (length weights)) idx))
             (bad))
           (replace (build-char-array ev len) weights :start1 idx)))
        ;; <a> <b> 2 n callothersubr pop: arithmetic.
        ((and (<= 20 subr-idx 23) (= num-args 2))
         (let* ((b (stack-pop-fixed stack))
                (a (stack-pop-fixed stack)))
           (stack-push-fixed stack
                             (case subr-idx
                               (20 (fixed+ a b))
                               (21 (fixed- a b))
                               (22 (fixed* a b))
                               (t (if (zerop b) (bad) (fixed/ a b)))))))
        ;; <val> <idx> 2 24 callothersubr stores val at idx.
        ((and (= subr-idx 24) (= num-args 2) has-blend)
         (let ((idx (u32-index)))
           (when (>= idx len) (bad))
           (setf (aref (build-char-array ev len) idx) (stack-pop-fixed stack))))
        ;; <idx> 1 25 callothersubr pop pushes the value at idx.
        ((and (= subr-idx 25) (= num-args 1) has-blend)
         (let ((idx (u32-index)))
           (when (>= idx len) (bad))
           (stack-push-fixed stack (aref (build-char-array ev len) idx))))
        ;; <a> <b> <c> <d> 4 27 callothersubr pop pushes a if c <= d, else b.
        ((and (= subr-idx 27) (= num-args 4))
         (let* ((d (stack-pop-fixed stack))
                (c (stack-pop-fixed stack))
                (b (stack-pop-fixed stack))
                (a (stack-pop-fixed stack)))
           (stack-push-fixed stack (if (<= c d) a b))))
        (t (bad))))))
